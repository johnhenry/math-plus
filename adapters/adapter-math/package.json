{
  "name": "@johnhenry/math-plus-adapter-math",
  "version": "0.0.0",
  "description": "Bridge between @johnhenry/math (Vector/Matrix, science/CAS side) and @johnhenry/math-plus-tensor-core (Tensor, engineering side) — Matrix/Vector <-> Tensor conversion (issue #14); Symbolic->tensor-compile IR (issue #15) and Symbolic->frame-arrow Expr (issue #38) compile targets, plus the DualNumber oracle, land here too",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "default": "./dist/test-utils.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "@johnhenry/math": "^0.0.0",
    "@johnhenry/math-plus-tensor-core": "^0.0.0",
    "@johnhenry/math-plus-tensor-compile": "^0.0.0",
    "@johnhenry/math-plus-frame-arrow": "^0.0.0"
  },
  "devDependencies": {
    "@johnhenry/math-plus-tensor-autograd": "^0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "adapters/adapter-math"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
