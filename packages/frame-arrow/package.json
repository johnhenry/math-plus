{
  "name": "@johnhenry/math-plus-frame-arrow",
  "version": "0.0.0",
  "description": "Immutable, expression-oriented Frame/Series dataframe library on top of apache-arrow — part of Math Plus",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "test:bun": "bun test ./test/"
  },
  "dependencies": {
    "apache-arrow": "21.2.0"
  },
  "peerDependencies": {
    "@johnhenry/math-plus-tensor-core": "^0.0.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/math-plus-tensor-core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/frame-arrow"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/math-plus/tree/main/packages/frame-arrow"
}
