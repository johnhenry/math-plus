{
  "name": "@johnhenry/math-plus-telemetry",
  "version": "0.0.2",
  "description": "Shared event schema + sink registry for math-plus (issue #10) — a stable stream any UI can consume later, with a zero-cost no-op default",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "test:bun": "bun test ./test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/telemetry"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/math-plus/tree/main/packages/telemetry"
}
