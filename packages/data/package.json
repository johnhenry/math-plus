{
  "name": "@johnhenry/math-plus-data",
  "version": "0.0.0",
  "description": "Async dataset pipelines for math-plus (issue #22) — the v2 `data` namespace: a curated Dataset facade over @johnhenry/iteration (chunk/batch/shuffle/epochs/mapConcurrent/prefetch/fold, AbortSignal cancellation) producing Tensor batches for tensor-autograd's trainer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "@johnhenry/iteration": "^0.0.0",
    "@johnhenry/math-plus-tensor-core": "^0.0.0"
  },
  "devDependencies": {
    "@johnhenry/math-plus-tensor-autograd": "^0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/data"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
