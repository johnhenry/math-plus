{
  "name": "@johnhenry/math-plus-tensor-webgpu",
  "version": "0.3.0",
  "description": "math-plus's WebGPU device: a facade over @johnhenry/backend-webgpu (the single WebGPU runtime: GEMM, fused attention, the tensor-backend op set) with explicit async transfers to/from tensor-core Tensors and tensor-compile IR -> WGSL elementwise fusion — browsers via navigator.gpu, Node/Bun via Dawn",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test --test-concurrency=1 test/*.test.ts",
    "test:bun": "bun test ./test/"
  },
  "dependencies": {
    "@johnhenry/backend-webgpu": "^0.4.0",
    "@johnhenry/math-plus-tensor-compile": "^0.1.3",
    "@johnhenry/math-plus-tensor-core": "^0.2.1",
    "@johnhenry/math-plus-tensor-cpu": "^0.2.1",
    "@johnhenry/tensor-backend": "^0.3.0"
  },
  "devDependencies": {
    "@johnhenry/math-plus-scalar-types": "^0.0.3",
    "@johnhenry/math-plus-tensor-wasm": "^0.1.2",
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/tensor-webgpu"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/math-plus/tree/main/packages/tensor-webgpu"
}
