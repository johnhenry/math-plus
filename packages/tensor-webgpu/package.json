{
  "name": "@johnhenry/math-plus-tensor-webgpu",
  "version": "0.1.3",
  "description": "WebGPU-accelerated GEMM (tiled / skinny / subgroup-matrix kernels, f32 and f16 storage with f32 accumulation), fused masked flash attention, attention-adjacent primitives, and #11-IR elementwise fusion for Math Plus tensors — browsers via navigator.gpu, Node/Bun via Dawn",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dawn": {
      "types": "./dist/dawn.d.ts",
      "default": "./dist/dawn.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test --test-concurrency=1 test/*.test.ts",
    "test:bun": "bun test ./test/"
  },
  "dependencies": {
    "@johnhenry/math-plus-tensor-core": "^0.2.0",
    "@johnhenry/math-plus-tensor-compile": "^0.1.2"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.7.0",
    "@johnhenry/math-plus-scalar-types": "^0.0.2",
    "@johnhenry/math-plus-tensor-wasm": "^0.1.1",
    "webgpu": "^0.6.1"
  },
  "peerDependencies": {
    "webgpu": "^0.6.1"
  },
  "peerDependenciesMeta": {
    "webgpu": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/tensor-webgpu"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/math-plus/tree/main/packages/tensor-webgpu"
}
