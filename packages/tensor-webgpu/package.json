{
  "name": "@johnhenry/math-plus-tensor-webgpu",
  "version": "0.0.0",
  "description": "WebGPU-accelerated GEMM, attention-adjacent primitives, and #11-IR elementwise fusion for Math Plus tensors (issue #12) \u2014 Chromium-family browsers only in v1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@johnhenry/math-plus-tensor-core": "^0.0.0",
    "@johnhenry/math-plus-tensor-compile": "^0.0.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.7.0",
    "@johnhenry/math-plus-scalar-types": "^0.0.0",
    "@johnhenry/math-plus-tensor-wasm": "^0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/tensor-webgpu"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
