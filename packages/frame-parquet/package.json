{
  "name": "@johnhenry/math-plus-frame-parquet",
  "version": "0.0.0",
  "description": "Parquet read/write bridge into @johnhenry/math-plus-frame-arrow's Frame, built on hyparquet (issue #20) — part of Math Plus",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "apache-arrow": "21.2.0",
    "hyparquet": "1.28.1",
    "hyparquet-writer": "0.16.6",
    "hyparquet-compressors": "1.1.1",
    "@hpcc-js/wasm-zstd": "1.15.0",
    "@johnhenry/math-plus-frame-arrow": "^0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/frame-parquet"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
