    "test:bun": "bun test ./test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/tensor-core"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/math-plus/tree/main/packages/tensor-core"
}
