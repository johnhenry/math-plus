{
  "name": "@johnhenry/math-plus-scalar-types",
  "version": "0.0.0",
  "description": "Thin re-export of @johnhenry/math scalar types (ComplexNumber, Rational, Decimal) plus tensor-boundary converters — the single import point for @johnhenry/math types in Math Plus",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "@johnhenry/math": "^0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/scalar-types"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
