{
  "name": "@johnhenry/math-plus-tensor-autograd",
  "version": "0.1.1",
  "description": "Reverse-mode automatic differentiation over @johnhenry/math-plus-tensor-core Tensors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./safetensors": {
      "types": "./dist/safetensors.d.ts",
      "default": "./dist/safetensors.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "test:bun": "bun test ./test/"
  },
  "dependencies": {
    "@johnhenry/math-plus-telemetry": "^0.0.2",
    "@johnhenry/math-plus-tensor-core": "^0.1.1"
  },
  "peerDependencies": {
    "@johnhenry/math-plus-safetensors": "^0.0.0 || ^0.1.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/math-plus-safetensors": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/math": "^0.0.1",
    "@johnhenry/math-plus-safetensors": "^0.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "packages/tensor-autograd"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/math-plus/tree/main/packages/tensor-autograd"
}
