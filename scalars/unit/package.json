{
  "name": "@johnhenry/math-plus-unit",
  "version": "0.0.3",
  "description": "Unit/dimension scalar type (issue #23) — magnitude plus dimension metadata, parsing, formatting, dimensional-analysis-checked arithmetic. Pure TypeScript, zero dependencies (conversion/parsing is metadata transformation, not bulk numeric work, per the acceleration test). Units never enter tensor storage.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "test:bun": "bun test ./test/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/math-plus.git",
    "directory": "scalars/unit"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/math-plus/tree/main/scalars/unit"
}
